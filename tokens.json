{
  "name": "ArcadeData design system",
  "version": "0.1.0",
  "prefix": "adb",
  "notes": "tokens.json is the source. css/tokens.css is generated from it by scripts/tokens.py. The contrast rule in scripts/contrast.py reads the pairs below.",
  "color": {
    "bg": {
      "light": "#FFFFFF", "dark": "#0F1217", "role": "background",
      "description": "Page background."
    },
    "bg-subtle": {
      "light": "#F5F6F7", "dark": "#151920", "role": "background",
      "description": "Sidebars, table heads, quiet bands. Docs site: --color-bg-secondary."
    },
    "bg-accent": {
      "light": "#F0F4F8", "dark": "#1C222C", "role": "background",
      "description": "Hover rows, hero bands, notes. Docs site: --color-bg-accent."
    },
    "surface": {
      "light": "#FAFBFC", "dark": "#1D232C", "role": "background",
      "description": "Panels that sit on the page background. Docs site: --color-surface."
    },
    "card": {
      "light": "#FFFFFF", "dark": "#1A1F27", "role": "background",
      "description": "Cards, dialogs, dropdowns. Docs site: --color-card."
    },
    "brand-tint": {
      "light": "#E8F4FD", "dark": "#1A3A4A", "role": "background",
      "description": "Light wash of the brand blue for selected rows and callouts. Studio: --color-brand-light."
    },
    "border": {
      "light": "#E2E8F0", "dark": "#2C3440", "role": "decoration",
      "description": "Dividers and card edges. Decorative, so no contrast minimum."
    },
    "border-subtle": {
      "light": "#EDF2F7", "dark": "#232A34", "role": "decoration",
      "description": "Faint dividers inside a card or table. Decorative."
    },
    "border-strong": {
      "light": "#718096", "dark": "#6B7788", "role": "ui",
      "description": "Edges of form controls. Needs 3:1 against the surface it sits on (WCAG 1.4.11)."
    },
    "text": {
      "light": "#1A1D23", "dark": "#E8ECF2", "role": "text",
      "description": "Body text and headings."
    },
    "text-muted": {
      "light": "#4A5568", "dark": "#AEB8C6", "role": "text",
      "description": "Secondary text, captions, placeholders that carry meaning."
    },
    "brand": {
      "light": "#00AEEE", "dark": "#29B6F6", "role": "fill",
      "description": "The ArcadeDB blue, for fills (buttons, active tabs, badges) and decoration. Never for text on a light page: 2.53:1 on white."
    },
    "brand-hover": {
      "light": "#0098D4", "dark": "#4FC3F7", "role": "fill",
      "description": "Hover state of a brand fill. Studio: --color-brand-hover."
    },
    "brand-border": {
      "light": "#0E76BC", "dark": "#29B6F6", "role": "ui",
      "description": "Border of a control that is filled or outlined in the brand blue. Studio: --color-brand-border."
    },
    "brand-text": {
      "light": "#007099", "dark": "#29B6F6", "role": "text",
      "description": "The brand blue as text and icons. Same hue as brand, darker on light pages so it passes 4.5:1 (5.56:1 on white). On dark pages it equals brand."
    },
    "brand-text-hover": {
      "light": "#00597A", "dark": "#4FC3F7", "role": "text",
      "description": "Hover state of brand-text."
    },
    "on-brand": {
      "light": "#0B1D29", "dark": "#0B1D29", "role": "text",
      "description": "Text on a brand fill. Dark ink in both themes: white on #00AEEE is 2.53:1."
    },
    "link": {
      "light": "#1565C0", "dark": "#6DB3FF", "role": "text",
      "description": "Links in running text. Docs site: --color-link."
    },
    "link-hover": {
      "light": "#104D92", "dark": "#9CCBFF", "role": "text",
      "description": "Hover state of a link. Docs site: --color-link-hover."
    },
    "focus": {
      "light": "#0066CC", "dark": "#8CC8FF", "role": "ui",
      "description": "Keyboard focus ring. Needs 3:1 against the surface. Docs site: --color-focus."
    },
    "danger": {
      "light": "#D32F2F", "dark": "#FF8A80", "role": "text",
      "description": "Errors and destructive actions, as text or icon. Pair with words or an icon, never colour alone."
    },
    "success": {
      "light": "#047857", "dark": "#34D399", "role": "text",
      "description": "Success text or icon. Docs site: --c-green-text."
    },
    "warning": {
      "light": "#B45309", "dark": "#FBBF24", "role": "text",
      "description": "Warning text or icon. Docs site: --c-amber-text."
    },
    "code-bg": {
      "light": "#1A1D23", "dark": "#0B0D11", "role": "background",
      "description": "Code blocks. Dark in both themes."
    },
    "code-text": {
      "light": "#E4E8EE", "dark": "#E4E8EE", "role": "text",
      "description": "Text in code blocks."
    },
    "code-comment": {
      "light": "#8B95A5", "dark": "#8B95A5", "role": "text",
      "description": "Comments in code blocks."
    },
    "inline-code-bg": {
      "light": "#F0F4F8", "dark": "#232A36", "role": "background",
      "description": "Background of inline code in running text."
    },
    "inline-code-text": {
      "light": "#0066CC", "dark": "#8CC8FF", "role": "text",
      "description": "Inline code in running text."
    }
  },
  "static": {
    "font-body": {
      "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif",
      "description": "Body font stack. Docs site: --font-body."
    },
    "font-heading": {
      "value": "'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "description": "Heading font stack. Docs site: --font-heading."
    },
    "font-code": {
      "value": "'JetBrains Mono', 'Monaco', 'Menlo', 'Ubuntu Mono', monospace",
      "description": "Code font stack. Docs site: --font-code."
    },
    "size-xs": { "value": "0.75rem", "description": "Type scale: labels, badges." },
    "size-sm": { "value": "0.875rem", "description": "Type scale: dense UI, code." },
    "size-md": { "value": "1rem", "description": "Type scale: body text." },
    "size-lg": { "value": "1.125rem", "description": "Type scale: lead text." },
    "size-xl": { "value": "1.25rem", "description": "Type scale: h4." },
    "size-2xl": { "value": "1.5rem", "description": "Type scale: h3." },
    "size-3xl": { "value": "1.875rem", "description": "Type scale: h2." },
    "size-4xl": { "value": "2.25rem", "description": "Type scale: h1." },
    "line-height-body": { "value": "1.6", "description": "Line height for running text." },
    "line-height-tight": { "value": "1.25", "description": "Line height for headings and dense UI." },
    "space-1": { "value": "0.25rem", "description": "Spacing scale, 4px steps." },
    "space-2": { "value": "0.5rem", "description": "Spacing scale." },
    "space-3": { "value": "0.75rem", "description": "Spacing scale." },
    "space-4": { "value": "1rem", "description": "Spacing scale." },
    "space-6": { "value": "1.5rem", "description": "Spacing scale." },
    "space-8": { "value": "2rem", "description": "Spacing scale." },
    "space-12": { "value": "3rem", "description": "Spacing scale." },
    "space-16": { "value": "4rem", "description": "Spacing scale." },
    "radius-sm": { "value": "4px", "description": "Small controls, inline code." },
    "radius-md": { "value": "6px", "description": "Inputs, buttons, cards. The value both sites use most." },
    "radius-lg": { "value": "8px", "description": "Dialogs and large panels." },
    "radius-pill": { "value": "9999px", "description": "Badges and chips." },
    "focus-width": { "value": "2px", "description": "Focus ring width." },
    "focus-offset": { "value": "2px", "description": "Gap between an element and its focus ring." }
  },
  "pairs": [
    { "fg": ["text"], "bg": ["bg", "bg-subtle", "bg-accent", "surface", "card", "brand-tint"], "min": 4.5, "use": "Body text on every page background" },
    { "fg": ["text-muted"], "bg": ["bg", "bg-subtle", "bg-accent", "surface", "card"], "min": 4.5, "use": "Secondary text" },
    { "fg": ["brand-text", "brand-text-hover"], "bg": ["bg", "bg-subtle", "bg-accent", "surface", "card", "brand-tint"], "min": 4.5, "use": "Brand blue as text" },
    { "fg": ["link", "link-hover"], "bg": ["bg", "bg-subtle", "bg-accent", "surface", "card"], "min": 4.5, "use": "Links" },
    { "fg": ["danger", "success", "warning"], "bg": ["bg", "bg-subtle", "bg-accent", "surface", "card"], "min": 4.5, "use": "Status text" },
    { "fg": ["on-brand"], "bg": ["brand", "brand-hover"], "min": 4.5, "use": "Label on a brand fill" },
    { "fg": ["code-text", "code-comment"], "bg": ["code-bg"], "min": 4.5, "use": "Code blocks" },
    { "fg": ["inline-code-text"], "bg": ["inline-code-bg"], "min": 4.5, "use": "Inline code" },
    { "fg": ["border-strong", "brand-border", "focus"], "bg": ["bg", "bg-subtle", "surface", "card"], "min": 3.0, "use": "Control borders and focus ring (WCAG 1.4.11)" }
  ]
}
